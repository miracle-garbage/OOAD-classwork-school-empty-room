@startuml 类图-领域实体类图
' ============================================================
' 分析模型 · 领域实体类图（Domain / Entity Class Diagram）
' 系统：校园空教室预约管理系统（CFRMS）
' 说明：按 OOSE「健壮分析 → 分析模型」的输出组织，实体类之间
'       的关系（泛化 / 聚合 / 组合 / 关联 / 多重度）是本图重点。
' ============================================================
title 图 1  校园空教室预约管理系统 · 领域实体类图
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 34
skinparam ranksep 46
hide circle
left to right direction

' ------------------------------------------------------------
' 一、用户与权限子域
' ------------------------------------------------------------
abstract class 用户 {
  # 用户编号 : String
  # 姓名 : String
  # 身份类型 : 身份类型
  # 所属院系 : String
  # 联系电话 : String
  # 账号状态 : 账号状态
  + 登录() : 会话
}

abstract class 预约用户 {
  + 查询空教室(条件 : 查询条件) : 教室[]
  + 提交预约(申请 : 预约申请) : 预约
  + 取消预约(预约号 : String)
  + 变更预约(预约号 : String, 新时段 : 时段)
  + 查询我的预约() : 预约[]
  + 签到(预约号 : String) : 签到记录
  + 是否受预约限制() : boolean
}

class 学生
class 教师

class 教室管理员 {
  + 审批预约(预约号 : String, 决定 : 审批结论)
  + 管理教室(教室 : 教室)
  + 管理违约与信用(用户 : 用户)
  + 查看统计() : 报表
}

class 系统管理员 {
  + 维护用户与权限(用户 : 用户, 角色 : 角色)
  + 配置系统参数()
}

class 教务管理人员 {
  + 查看统计报表() : 报表
}

class 角色 {
  - 角色编号 : String
  - 角色名称 : String
  + 分配权限(权限 : 权限)
}

class 权限 {
  - 权限编号 : String
  - 权限码 : String
  - 资源 : String
  - 操作 : String
}

class 登录日志 {
  - 日志号 : String
  - 登录时间 : DateTime
  - 来源IP : String
  - 登录方式 : String
  - 结果 : String
}

class 信用信息 {
  - 违约累计 : int
  - 信用状态 : 信用状态
  - 限制起始 : DateTime
  - 限制截止 : DateTime
  + 记录违约(违约 : 违约记录)
  + 重算信用()
  + 是否受限() : boolean
}

' ------------------------------------------------------------
' 二、教室与资源子域
' ------------------------------------------------------------
class 教室 {
  - 教室编号 : String
  - 楼栋 : String
  - 房间号 : String
  - 容量 : int
  - 教室类型 : 教室类型
  - 状态 : 教室状态
  - 是否可预约 : boolean
  - 是否需审批 : boolean
  + 查询空闲时段(日期 : Date, 时段 : 时段) : 时段[]
  + 是否满足容量(人数 : int) : boolean
}

class 教室设备 {
  - 设备编号 : String
  - 设备名称 : String
  - 设备类型 : String
  - 数量 : int
}

class 开放时间规则 {
  - 规则号 : String
  - 生效学期 : String
  - 星期 : int
  - 起止时间 : 时段
  - 是否可预约 : boolean
}

class 课表占用 {
  - 占用号 : String
  - 课程名称 : String
  - 任课教师 : String
  - 时段 : 时段
}

class 时段 <<值对象>> {
  - 日期 : Date
  - 开始时间 : Time
  - 结束时间 : Time
  + 时长() : Duration
  + 是否重叠(其他 : 时段) : boolean
  + 是否合法() : boolean
}

' ------------------------------------------------------------
' 三、预约与使用子域
' ------------------------------------------------------------
class 预约 {
  - 预约号 : String
  - 用途类别 : 用途类别
  - 使用人数 : int
  - 联系电话 : String
  - 备注 : String
  - 状态 : 预约状态
  - 提交时间 : DateTime
  - 是否需审批 : boolean
  - 签到码 : String
  - 签到时间窗 : 时段
  + 提交() : 预约
  + 校验可用性() : 校验结果
  + 审批(决定 : 审批结论)
  + 取消()
  + 变更(新教室 : 教室, 新时段 : 时段)
  + 签到() : 签到记录
  + 超时释放()
  + 是否可取消() : boolean
}

class 用途类别 <<枚举>> {
  自习
  小组讨论
  补课
  答疑
  会议
  社团活动
  --
  + 是否需要审批() : boolean
  + 是否需要材料() : boolean
  + 最早提前量() : Duration
}

class 签到记录 {
  - 记录号 : String
  - 签到时间 : DateTime
  - 签到方式 : 签到方式
  - 是否代签 : boolean
  - 代签操作人 : String
  - 原因 : String
}

class 审批日志 {
  - 日志号 : String
  - 审批人 : String
  - 审批时间 : DateTime
  - 结论 : 审批结论
  - 理由 : String
  - 是否调整资源 : boolean
}

class 违约记录 {
  - 记录号 : String
  - 违约类型 : 违约类型
  - 发生时间 : DateTime
  - 是否撤销 : boolean
}

class 证明材料 {
  - 材料号 : String
  - 文件名 : String
  - 上传时间 : DateTime
}

class 通知 {
  - 通知号 : String
  - 通知类型 : 通知类型
  - 内容 : String
  - 渠道 : 渠道
  - 状态 : 发送状态
  - 重试次数 : int
}

' ============================================================
' 关系：泛化
' ============================================================
用户 <|-- 预约用户
用户 <|-- 教室管理员
用户 <|-- 系统管理员
用户 <|-- 教务管理人员
预约用户 <|-- 学生
预约用户 <|-- 教师

' ============================================================
' 关系：关联 / 聚合 / 组合（含多重度）
' ============================================================
用户 "1..*" -- "0..*" 角色 : 拥有
角色 "1..*" -- "0..*" 权限 : 包含
用户 "1" -- "0..*" 登录日志 : 产生
预约用户 "1" -- "1" 信用信息 : 对应

教室 "1" *-- "0..*" 教室设备 : 配置
教室 "1" o-- "1..*" 开放时间规则 : 遵循
教室 "1" -- "0..*" 课表占用 : 被占用
教室 "1" -- "0..*" 预约 : 被预约

预约用户 "1" -- "0..*" 预约 : 提交
预约 "0..*" -- "1" 时段 : 占用
预约 "0..*" -- "1" 用途类别 : 分类
预约 "1" -- "0..*" 证明材料 : 附有
预约 "1" -- "0..1" 签到记录 : 对应
预约 "1" -- "0..*" 审批日志 : 留有
预约 "1" -- "0..*" 违约记录 : 触发
预约用户 "1" -- "0..*" 违约记录 : 累计
预约 "1" -- "0..*" 通知 : 触发

课表占用 "0..*" -- "1" 时段 : 对应
开放时间规则 "0..*" -- "1" 时段 : 定义

@enduml
